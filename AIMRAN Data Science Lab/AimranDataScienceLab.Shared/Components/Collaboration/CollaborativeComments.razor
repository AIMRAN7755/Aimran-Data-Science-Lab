@implements IAsyncDisposable
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client

<div class="collaborative-comments-container">
    <div class="comments-header">
        <h4>
            <span class="comments-icon">💬</span>
            Comments & Discussion
            <span class="comment-count badge badge-primary">@TotalComments</span>
        </h4>
        <div class="comments-controls">
            <button class="toggle-btn @(ShowOnlyUnresolved ? "active" : "")" 
                    @onclick="ToggleUnresolvedFilter"
                    title="Show only unresolved">
                ⚠️ Unresolved
            </button>
        </div>
    </div>

    <div class="comments-list" @ref="commentsRef">
        @if (DisplayedComments.Count == 0)
        {
            <div class="empty-state">
                <p class="text-muted">No comments yet. Be the first to share your thoughts!</p>
            </div>
        }
        else
        {
            @foreach (var comment in DisplayedComments)
            {
                <div class="comment-item" data-comment-id="@comment.Id">
                    <div class="comment-header">
                        <div class="author-info">
                            <div class="author-avatar">
                                @comment.AuthorName.First()
                            </div>
                            <div class="author-details">
                                <span class="author-name">@comment.AuthorName</span>
                                <span class="author-email">@comment.AuthorEmail</span>
                            </div>
                        </div>
                        <div class="comment-meta">
                            <span class="comment-time" title="@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                                @GetTimeAgo(comment.CreatedAt)
                            </span>
                            @if (comment.IsResolved)
                            {
                                <span class="resolved-badge">✓ Resolved</span>
                            }
                        </div>
                    </div>

                    @if (comment.LineNumber.HasValue)
                    {
                        <div class="comment-location">
                            <span class="location-icon">📍</span>
                            Line @comment.LineNumber
                        </div>
                    }

                    <div class="comment-content">
                        @comment.Content
                    </div>

                    @if (comment.Reactions.Count > 0)
                    {
                        <div class="comment-reactions">
                            @foreach (var reaction in comment.Reactions)
                            {
                                <div class="reaction-chip" title="@string.Join(", ", reaction.Value)">
                                    <span class="reaction-emoji">@reaction.Key</span>
                                    <span class="reaction-count">@reaction.Value.Count</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="comment-actions">
                        <button class="action-btn reply-btn" @onclick="@(() => ToggleReplyForm(comment.Id))">
                            <span class="action-icon">↩️</span> Reply
                        </button>
                        <button class="action-btn reaction-btn" @onclick="@(() => ShowReactionPicker(comment.Id))">
                            <span class="action-icon">😊</span> React
                        </button>
                        @if (!comment.IsResolved)
                        {
                            <button class="action-btn resolve-btn" @onclick="@(() => ResolveCommentAsync(comment.Id))">
                                <span class="action-icon">✓</span> Resolve
                            </button>
                        }
                    </div>

                    @if (ExpandedReplies.Contains(comment.Id))
                    {
                        <div class="replies-section">
                            @foreach (var reply in comment.Replies)
                            {
                                <div class="reply-item">
                                    <div class="reply-header">
                                        <span class="reply-author">@reply.AuthorName</span>
                                        <span class="reply-time">@GetTimeAgo(reply.CreatedAt)</span>
                                    </div>
                                    <div class="reply-content">
                                        @reply.Content
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (ReplyFormVisibleFor == comment.Id)
                    {
                        <div class="reply-form">
                            <textarea class="reply-input" 
                                      @bind="ReplyContent" 
                                      placeholder="Write a reply..."
                                      rows="2"></textarea>
                            <div class="form-actions">
                                <button class="btn btn-primary" @onclick="@(() => SubmitReplyAsync(comment.Id))">
                                    Post Reply
                                </button>
                                <button class="btn btn-secondary" @onclick="@(() => CancelReply())">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="add-comment-section">
        <h5>Add Comment</h5>
        <textarea class="comment-input" 
                  @bind="NewCommentContent" 
                  placeholder="Share your thoughts, ask questions, or mention someone..."
                  rows="3"></textarea>

        <div class="comment-options">
            <div class="line-number-input">
                <label>Line Number (optional):</label>
                <input type="number" 
                       @bind="NewCommentLineNumber" 
                       placeholder="Leave blank for general comment"
                       min="1" />
            </div>

            <div class="mentions-input">
                <label>Mention Users:</label>
                <input type="text" 
                       @bind="MentionSearchText" 
                       placeholder="Type to search users..."
                       @oninput="OnMentionSearch" />
                @if (AvailableUsers.Count > 0 && !string.IsNullOrEmpty(MentionSearchText))
                {
                    <div class="user-suggestions">
                        @foreach (var user in AvailableUsers)
                        {
                            <div class="user-suggestion" @onclick="@(() => SelectMention(user))">
                                <span class="user-avatar-small">@user.First()</span>
                                @user
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SubmitCommentAsync" disabled="@(string.IsNullOrWhiteSpace(NewCommentContent))">
                Post Comment
            </button>
            <button class="btn btn-secondary" @onclick="CancelComment">
                Cancel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? ResourceId { get; set; }

    [Parameter]
    public EventCallback<string> OnCommentAdded { get; set; }

    [Parameter]
    public List<string> AvailableUsers { get; set; } = new();

    private List<CommentViewModel> DisplayedComments { get; set; } = new();
    private List<CommentViewModel> AllComments { get; set; } = new();
    private HubConnection? HubConnection;
    private ElementReference commentsRef;

    private string NewCommentContent { get; set; } = "";
    private int? NewCommentLineNumber { get; set; }
    private string MentionSearchText { get; set; } = "";
    private List<string> MentionedUsers { get; set; } = new();
    private List<string> FilteredUsers { get; set; } = new();

    private string ReplyContent { get; set; } = "";
    private string? ReplyFormVisibleFor { get; set; }
    private List<string> ExpandedReplies { get; set; } = new();

    private bool ShowOnlyUnresolved { get; set; }
    private int TotalComments { get; set; }
    private string CurrentUserId { get; set; } = "current-user";
    private string CurrentUserName { get; set; } = "You";
    private string CurrentUserEmail { get; set; } = "user@example.com";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(ResourceId))
            return;

        HubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/collaborationhub"))
            .WithAutomaticReconnect()
            .Build();

        // Register event handlers
        HubConnection.On<dynamic>("CommentAdded", async (comment) =>
        {
            await AddCommentToList(comment);
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        });

        HubConnection.On<dynamic>("CommentReplyAdded", async (reply) =>
        {
            await AddReplyToComment(reply);
            await InvokeAsync(StateHasChanged);
        });

        HubConnection.On<dynamic>("CommentResolved", async (data) =>
        {
            await MarkCommentResolved(data.commentId);
            await InvokeAsync(StateHasChanged);
        });

        HubConnection.On<dynamic>("ReactionAdded", async (data) =>
        {
            await AddReactionToComment(data.commentId, data.userId, data.reaction);
            await InvokeAsync(StateHasChanged);
        });

        await HubConnection.StartAsync();
        RefreshCommentDisplay();
    }

    private async Task AddCommentToList(dynamic comment)
    {
        var commentItem = new CommentViewModel
        {
            Id = comment.commentId,
            AuthorName = comment.userName,
            AuthorEmail = "author@example.com",
            Content = comment.content,
            ResourceId = comment.resourceId ?? "",
            LineNumber = comment.lineNumber,
            CreatedAt = comment.timestamp ?? DateTime.UtcNow
        };

        AllComments.Insert(0, commentItem);
        TotalComments = AllComments.Count;
        RefreshCommentDisplay();
    }

    private async Task AddReplyToComment(dynamic reply)
    {
        var parentId = reply.parentCommentId;
        var parent = AllComments.FirstOrDefault(c => c.Id == parentId);
        if (parent != null)
        {
            var replyItem = new CommentViewModel
            {
                Id = reply.replyId,
                AuthorName = reply.userName,
                AuthorEmail = "author@example.com",
                Content = reply.content,
                CreatedAt = reply.timestamp ?? DateTime.UtcNow
            };

            parent.Replies.Add(replyItem);
            if (!ExpandedReplies.Contains(parentId))
            {
                ExpandedReplies.Add(parentId);
            }
        }
    }

    private async Task MarkCommentResolved(string commentId)
    {
        var comment = AllComments.FirstOrDefault(c => c.Id == commentId);
        if (comment != null)
        {
            comment.IsResolved = true;
            comment.ResolvedAt = DateTime.UtcNow;
        }
        RefreshCommentDisplay();
    }

    private async Task AddReactionToComment(string commentId, string userId, string reaction)
    {
        var comment = AllComments.FirstOrDefault(c => c.Id == commentId);
        if (comment != null)
        {
            if (!comment.Reactions.ContainsKey(reaction))
            {
                comment.Reactions[reaction] = new();
            }
            if (!comment.Reactions[reaction].Contains(userId))
            {
                comment.Reactions[reaction].Add(userId);
            }
        }
    }

    private async Task SubmitCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(NewCommentContent) || string.IsNullOrEmpty(ResourceId))
            return;

        try
        {
            if (HubConnection?.State == HubConnectionState.Connected)
            {
                await HubConnection.SendAsync("AddCommentAsync",
                    CurrentUserId,
                    CurrentUserName,
                    CurrentUserEmail,
                    NewCommentContent,
                    ResourceId,
                    "Resource",
                    "project-id", // Would get from context
                    MentionedUsers,
                    NewCommentLineNumber);

                await OnCommentAdded.InvokeAsync(NewCommentContent);
            }

            NewCommentContent = "";
            NewCommentLineNumber = null;
            MentionedUsers.Clear();
        }
        catch (Exception)
        {
            // Log error
        }
    }

    private async Task SubmitReplyAsync(string parentCommentId)
    {
        if (string.IsNullOrWhiteSpace(ReplyContent))
            return;

        try
        {
            if (HubConnection?.State == HubConnectionState.Connected)
            {
                await HubConnection.SendAsync("ReplyToCommentAsync",
                    CurrentUserId,
                    CurrentUserName,
                    CurrentUserEmail,
                    ReplyContent,
                    parentCommentId,
                    "project-id",
                    MentionedUsers);
            }

            ReplyContent = "";
            ReplyFormVisibleFor = null;
        }
        catch (Exception)
        {
            // Log error
        }
    }

    private async Task ResolveCommentAsync(string commentId)
    {
        try
        {
            if (HubConnection?.State == HubConnectionState.Connected)
            {
                await HubConnection.SendAsync("ResolveCommentAsync", commentId);
            }
        }
        catch (Exception)
        {
            // Log error
        }
    }

    private void ToggleReplyForm(string commentId)
    {
        ReplyFormVisibleFor = ReplyFormVisibleFor == commentId ? null : commentId;
        if (ReplyFormVisibleFor != commentId)
        {
            ExpandedReplies.Add(commentId);
        }
    }

    private void ToggleUnresolvedFilter()
    {
        ShowOnlyUnresolved = !ShowOnlyUnresolved;
        RefreshCommentDisplay();
    }

    private void ShowReactionPicker(string commentId)
    {
        // Would show emoji picker here
    }

    private void OnMentionSearch(ChangeEventArgs e)
    {
        MentionSearchText = e.Value?.ToString() ?? "";
        FilteredUsers = AvailableUsers?
            .Where(u => u.Contains(MentionSearchText, StringComparison.OrdinalIgnoreCase))
            .Take(5)
            .ToList() ?? new();
    }

    private void SelectMention(string userName)
    {
        if (!MentionedUsers.Contains(userName))
        {
            MentionedUsers.Add(userName);
        }
        MentionSearchText = "";
        FilteredUsers.Clear();
    }

    private void CancelReply()
    {
        ReplyContent = "";
        ReplyFormVisibleFor = null;
    }

    private void CancelComment()
    {
        NewCommentContent = "";
        NewCommentLineNumber = null;
        MentionedUsers.Clear();
    }

    private void RefreshCommentDisplay()
    {
        DisplayedComments = ShowOnlyUnresolved
            ? AllComments.Where(c => !c.IsResolved).ToList()
            : AllComments.ToList();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(100);
            // Would use JS interop to scroll here
        }
        catch
        {
            // Ignore scroll errors
        }
    }

    private string GetTimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        return span.TotalSeconds < 60 ? "just now"
            : span.TotalMinutes < 60 ? $"{(int)span.TotalMinutes}m ago"
            : span.TotalHours < 24 ? $"{(int)span.TotalHours}h ago"
            : $"{(int)span.TotalDays}d ago";
    }

    private class CommentViewModel
    {
        public string Id { get; set; } = string.Empty;
        public string AuthorName { get; set; } = string.Empty;
        public string AuthorEmail { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public string ResourceId { get; set; } = string.Empty;
        public int? LineNumber { get; set; }
        public DateTime CreatedAt { get; set; }
        public bool IsResolved { get; set; }
        public DateTime? ResolvedAt { get; set; }
        public List<CommentViewModel> Replies { get; set; } = new();
        public Dictionary<string, List<string>> Reactions { get; set; } = new();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (HubConnection is not null)
        {
            await HubConnection.DisposeAsync();
        }
    }
}

