@using AIMRAN_Data_Science_Lab.Services.Collaboration
@using AIMRAN_Data_Science_Lab.Services.Notifications
@using AIMRAN_Data_Science_Lab.Domain.Collaboration
@inject IPresenceService PresenceService
@inject ICollaborationService CollaborationService
@inject IConflictResolutionService ConflictResolutionService
@inject IRealTimeNotificationService NotificationService

<div class="collaboration-dashboard">
    <div class="collaboration-header">
        <h2>
            <span class="header-icon">🤝</span>
            Team Collaboration
        </h2>
        <div class="header-stats">
            <div class="stat-badge">
                <span class="stat-icon">👥</span>
                <span class="stat-value">@OnlineUserCount</span>
                <span class="stat-label">Online</span>
            </div>
            <div class="stat-badge">
                <span class="stat-icon">📋</span>
                <span class="stat-value">@ActivityCount</span>
                <span class="stat-label">Activities</span>
            </div>
            <div class="stat-badge">
                <span class="stat-icon">💬</span>
                <span class="stat-value">@CommentCount</span>
                <span class="stat-label">Comments</span>
            </div>
            <div class="stat-badge">
                <span class="stat-icon">⚠️</span>
                <span class="stat-value">@ConflictCount</span>
                <span class="stat-label">Conflicts</span>
            </div>
        </div>
    </div>

    <div class="collaboration-grid">
        <!-- PRESENCE PANEL -->
        <div class="panel presence-panel">
            <h3>
                <span class="panel-icon">👥</span>
                Team Members
            </h3>
            <div class="panel-content">
                @if (OnlineUsers.Count == 0)
                {
                    <div class="empty-message">No members online</div>
                }
                else
                {
                    <div class="user-list">
                        @foreach (var user in OnlineUsers)
                        {
                            <div class="user-item">
                                <div class="user-avatar">@user.UserName.First()</div>
                                <div class="user-details">
                                    <div class="user-name">@user.UserName</div>
                                    <div class="user-activity">
                                        @if (!string.IsNullOrEmpty(user.CurrentResourceType))
                                        {
                                            <small>✏️ Editing @user.CurrentResourceType</small>
                                        }
                                        else
                                        {
                                            <small>👁️ Viewing</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ACTIVITY FEED PANEL -->
        <div class="panel activity-panel">
            <h3>
                <span class="panel-icon">📋</span>
                Recent Activity
            </h3>
            <div class="panel-content scrollable">
                @if (RecentActivities.Count == 0)
                {
                    <div class="empty-message">No recent activities</div>
                }
                else
                {
                    @foreach (var activity in RecentActivities.Take(10))
                    {
                        <div class="activity-item">
                            <span class="activity-icon">@GetActivityIcon(activity.ActivityType)</span>
                            <div class="activity-text">
                                <span class="activity-user">@activity.UserName</span>
                                <span class="activity-desc">@activity.Description</span>
                                <span class="activity-time">@GetTimeAgo(activity.CreatedAt)</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- COMMENTS PANEL -->
        <div class="panel comments-panel">
            <h3>
                <span class="panel-icon">💬</span>
                Comments
                @if (UnresolvedComments > 0)
                {
                    <span class="unresolved-badge">@UnresolvedComments</span>
                }
            </h3>
            <div class="panel-content scrollable">
                @if (RecentComments.Count == 0)
                {
                    <div class="empty-message">No comments yet</div>
                }
                else
                {
                    @foreach (var comment in RecentComments.Take(5))
                    {
                        <div class="comment-item" style="border-left-color: @(comment.IsResolved ? "#4caf50" : "#ff9800");">
                            <div class="comment-header">
                                <span class="comment-author">@comment.AuthorName</span>
                                <span class="comment-time">@GetTimeAgo(comment.CreatedAt)</span>
                            </div>
                            <div class="comment-content">@comment.Content</div>
                            @if (!comment.IsResolved)
                            {
                                <div class="comment-status">Unresolved</div>
                            }
                            else
                            {
                                <div class="comment-status resolved">✓ Resolved</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- NOTIFICATIONS PANEL -->
        <div class="panel notifications-panel">
            <h3>
                <span class="panel-icon">🔔</span>
                Notifications
                @if (UnreadNotifications > 0)
                {
                    <span class="unread-badge">@UnreadNotifications</span>
                }
            </h3>
            <div class="panel-content scrollable">
                @if (RecentNotifications.Count == 0)
                {
                    <div class="empty-message">No notifications</div>
                }
                else
                {
                    @foreach (var notif in RecentNotifications.Take(5))
                    {
                        <div class="notification-item @(notif.IsRead ? "read" : "unread")">
                            <div class="notification-type">@GetNotificationIcon(notif.NotificationType)</div>
                            <div class="notification-content">
                                <div class="notification-title">@notif.Title</div>
                                <div class="notification-message">@notif.Message</div>
                                <div class="notification-time">@GetTimeAgo(notif.CreatedAt)</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- COLLABORATION CONTROLS -->
    <div class="collaboration-controls">
        <button class="control-btn refresh-btn" @onclick="RefreshAsync" title="Refresh all data">
            🔄 Refresh
        </button>
        <button class="control-btn clear-btn" @onclick="ClearAllNotificationsAsync" title="Clear all notifications">
            🗑️ Clear
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string? ProjectId { get; set; }

    [Parameter]
    public string? CurrentUserId { get; set; } = "current-user";

    private List<UserPresence> OnlineUsers { get; set; } = new();
    private List<ActivityEvent> RecentActivities { get; set; } = new();
    private List<CollaborativeComment> RecentComments { get; set; } = new();
    private List<CollaborationNotification> RecentNotifications { get; set; } = new();

    private int OnlineUserCount { get; set; }
    private int ActivityCount { get; set; }
    private int CommentCount { get; set; }
    private int ConflictCount { get; set; }
    private int UnresolvedComments { get; set; }
    private int UnreadNotifications { get; set; }

    private Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(ProjectId))
            return;

        await RefreshAsync();

        // Auto-refresh every 5 seconds
        _refreshTimer = new Timer(async _ =>
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshAsync()
    {
        try
        {
            // Refresh online users
            OnlineUsers = await PresenceService.GetOnlineUsersInProjectAsync(ProjectId ?? "");
            OnlineUserCount = OnlineUsers.Count;

            // Refresh activity
            RecentActivities = await CollaborationService.GetProjectActivitiesAsync(ProjectId ?? "", take: 50);
            ActivityCount = RecentActivities.Count;

            // Refresh comments
            RecentComments = await CollaborationService.GetCommentsForResourceAsync(ProjectId ?? "");
            CommentCount = RecentComments.Count;
            UnresolvedComments = RecentComments.Count(c => !c.IsResolved);

            // Refresh notifications
            RecentNotifications = await NotificationService.GetUserNotificationsAsync(CurrentUserId ?? "", unreadOnly: false);
            UnreadNotifications = RecentNotifications.Count(n => !n.IsRead);

            // Get presence stats
            var stats = await PresenceService.GetPresenceStatisticsAsync(ProjectId ?? "");
            ConflictCount = stats.EditorsPerResource.Count;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error refreshing collaboration dashboard: {ex.Message}");
        }
    }

    private async Task ClearAllNotificationsAsync()
    {
        await NotificationService.ClearUserNotificationsAsync(CurrentUserId ?? "");
        RecentNotifications.Clear();
        UnreadNotifications = 0;
    }

    private string GetActivityIcon(string activityType) => activityType switch
    {
        "ModelCreated" => "🤖",
        "DatasetCleaned" => "🧹",
        "PipelineExecuted" => "⚙️",
        "CommentAdded" => "💬",
        "ApprovalRequested" => "✅",
        _ => "📝"
    };

    private string GetNotificationIcon(string notificationType) => notificationType switch
    {
        "Mention" => "👤",
        "ApprovalRequest" => "✅",
        "CommentReply" => "💬",
        "ResourceUpdate" => "📝",
        "Alert" => "⚠️",
        _ => "🔔"
    };

    private string GetTimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        return span.TotalSeconds < 60 ? "just now"
            : span.TotalMinutes < 60 ? $"{(int)span.TotalMinutes}m"
            : span.TotalHours < 24 ? $"{(int)span.TotalHours}h"
            : $"{(int)span.TotalDays}d";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}

