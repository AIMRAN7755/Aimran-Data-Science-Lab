@page "/experiments"
@inject IExperimentService ExperimentService
@inject IDatasetService DatasetService
@inject IProjectService ProjectService
@inject IAzureMlService AzureMlService

<PageTitle>Experiments - DS-Workbench</PageTitle>

<div class="page-container">
    <header class="page-header">
        <div class="header-content">
            <h1>🧪 Experiment Center</h1>
            <p>Track, compare, and manage your ML experiments</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" @onclick="ShowCreateDialog">
                <span>➕</span> New Experiment
            </button>
        </div>
    </header>

    <!-- Status Overview -->
    <div class="status-overview">
        <div class="status-card running">
            <span class="status-count">@_runningCount</span>
            <span class="status-label">Running</span>
        </div>
        <div class="status-card completed">
            <span class="status-count">@_completedCount</span>
            <span class="status-label">Completed</span>
        </div>
        <div class="status-card failed">
            <span class="status-count">@_failedCount</span>
            <span class="status-label">Failed</span>
        </div>
        <div class="status-card pending">
            <span class="status-count">@_pendingCount</span>
            <span class="status-label">Pending</span>
        </div>
    </div>

    <!-- Experiment List -->
    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading experiments...</p>
        </div>
    }
    else if (!_experiments.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🧪</div>
            <h3>No experiments yet</h3>
            <p>Create your first experiment to start training models.</p>
            <button class="btn btn-primary" @onclick="ShowCreateDialog">Create Experiment</button>
        </div>
    }
    else
    {
        <div class="experiment-table">
            <table>
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Name</th>
                        <th>Compute</th>
                        <th>Started</th>
                        <th>Duration</th>
                        <th>Metrics</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var experiment in _experiments.OrderByDescending(e => e.CreatedAt))
                    {
                        <tr>
                            <td>
                                <span class="status-badge @experiment.Status.ToString().ToLower()">
                                    @GetStatusIcon(experiment.Status) @experiment.Status
                                </span>
                            </td>
                            <td>
                                <div class="experiment-name">
                                    <strong>@experiment.Name</strong>
                                    <small>@(experiment.Description ?? "")</small>
                                </div>
                            </td>
                            <td>
                                <span class="compute-badge @experiment.ComputeTarget.ToString().ToLower()">
                                    @GetComputeIcon(experiment.ComputeTarget) @experiment.ComputeTarget
                                </span>
                            </td>
                            <td>@(experiment.StartedAt?.ToString("g") ?? "-")</td>
                            <td>@GetDuration(experiment)</td>
                            <td>
                                @if (experiment.Metrics.Any())
                                {
                                    <div class="metrics-preview">
                                        @foreach (var metric in experiment.Metrics.Take(2))
                                        {
                                            <span>@metric.Key: @metric.Value.ToString("F3")</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="no-metrics">-</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    @if (experiment.Status == ExperimentStatus.Pending)
                                    {
                                        <button class="btn-icon" title="Start" @onclick="() => StartExperiment(experiment.Id)">▶️</button>
                                        <button class="btn-icon cloud" title="Run in Azure" @onclick="() => StartInAzure(experiment.Id)">☁️</button>
                                    }
                                    @if (experiment.Status == ExperimentStatus.Running)
                                    {
                                        <button class="btn-icon" title="Stop" @onclick="() => StopExperiment(experiment.Id)">⏹️</button>
                                    }
                                    <button class="btn-icon" title="View Details" @onclick="() => ViewDetails(experiment.Id)">👁️</button>
                                    <button class="btn-icon danger" title="Delete" @onclick="() => DeleteExperiment(experiment.Id)">🗑️</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Create Dialog -->
    @if (_showCreateDialog)
    {
        <div class="modal-overlay" @onclick="HideCreateDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>New Experiment</h2>
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="_newName" placeholder="My Experiment" />
                </div>
                <div class="form-group">
                    <label>Project</label>
                    <select @bind="_selectedProjectId">
                        <option value="">Select a project...</option>
                        @foreach (var project in _projects)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Dataset</label>
                    <select @bind="_selectedDatasetId">
                        <option value="">Select a dataset...</option>
                        @foreach (var dataset in _datasets)
                        {
                            <option value="@dataset.Id">@dataset.Name (v@dataset.Version)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Description (optional)</label>
                    <textarea @bind="_newDescription" placeholder="Describe your experiment..."></textarea>
                </div>
                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="HideCreateDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateExperiment">Create</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Experiment> _experiments = [];
    private List<Project> _projects = [];
    private List<Dataset> _datasets = [];
    private bool _isLoading = true;

    // Stats
    private int _runningCount;
    private int _completedCount;
    private int _failedCount;
    private int _pendingCount;

    // Create dialog
    private bool _showCreateDialog;
    private string _newName = "";
    private string _newDescription = "";
    private string _selectedProjectId = "";
    private string _selectedDatasetId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;

        var experimentsTask = ExperimentService.GetAllAsync();
        var projectsTask = ProjectService.GetAllAsync();
        var datasetsTask = DatasetService.GetAllAsync();

        await Task.WhenAll(experimentsTask, projectsTask, datasetsTask);

        _experiments = (await experimentsTask).ToList();
        _projects = (await projectsTask).ToList();
        _datasets = (await datasetsTask).ToList();

        UpdateStats();
        _isLoading = false;
    }

    private void UpdateStats()
    {
        _runningCount = _experiments.Count(e => e.Status == ExperimentStatus.Running);
        _completedCount = _experiments.Count(e => e.Status == ExperimentStatus.Completed);
        _failedCount = _experiments.Count(e => e.Status == ExperimentStatus.Failed);
        _pendingCount = _experiments.Count(e => e.Status == ExperimentStatus.Pending);
    }

    private void ShowCreateDialog() => _showCreateDialog = true;
    private void HideCreateDialog()
    {
        _showCreateDialog = false;
        _newName = "";
        _newDescription = "";
        _selectedProjectId = "";
        _selectedDatasetId = "";
    }

    private async Task CreateExperiment()
    {
        if (string.IsNullOrWhiteSpace(_newName) ||
            !Guid.TryParse(_selectedProjectId, out var projectId) ||
            !Guid.TryParse(_selectedDatasetId, out var datasetId))
            return;

        await ExperimentService.CreateAsync(_newName, projectId, datasetId, _newDescription);
        HideCreateDialog();
        await LoadDataAsync();
    }

    private async Task StartExperiment(Guid id)
    {
        await ExperimentService.StartAsync(id);
        await LoadDataAsync();
    }

    private async Task StartInAzure(Guid id)
    {
        await ExperimentService.StartAsync(id, target: ComputeTarget.AzureMl);
        await LoadDataAsync();
    }

    private async Task StopExperiment(Guid id)
    {
        await ExperimentService.StopAsync(id);
        await LoadDataAsync();
    }

    private async Task DeleteExperiment(Guid id)
    {
        await ExperimentService.DeleteAsync(id);
        await LoadDataAsync();
    }

    private void ViewDetails(Guid id)
    {
        // TODO: Navigate to experiment details
    }

    private static string GetStatusIcon(ExperimentStatus status) => status switch
    {
        ExperimentStatus.Running => "🔄",
        ExperimentStatus.Completed => "✅",
        ExperimentStatus.Failed => "❌",
        ExperimentStatus.Cancelled => "⏹️",
        ExperimentStatus.Pending => "⏳",
        _ => "❓"
    };

    private static string GetComputeIcon(ComputeTarget target) => target switch
    {
        ComputeTarget.Local => "💻",
        ComputeTarget.AzureMl => "☁️",
        ComputeTarget.AzureGpu => "🎮",
        _ => "❓"
    };

    private static string GetDuration(Experiment experiment)
    {
        if (experiment.StartedAt is null)
            return "-";

        var end = experiment.CompletedAt ?? DateTime.UtcNow;
        var duration = end - experiment.StartedAt.Value;

        return duration.TotalHours >= 1
            ? $"{duration.TotalHours:F1}h"
            : duration.TotalMinutes >= 1
                ? $"{duration.TotalMinutes:F0}m"
                : $"{duration.TotalSeconds:F0}s";
    }
}
