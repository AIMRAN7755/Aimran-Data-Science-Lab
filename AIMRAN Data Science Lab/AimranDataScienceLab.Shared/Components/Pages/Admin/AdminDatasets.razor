@page "/admin/datasets"
@layout AdminLayout
@inject IDatasetService DatasetService
@inject IAdminService AdminService

<PageTitle>Dataset Management - AIMRAN Admin</PageTitle>

<div class="admin-page">
    <h1 class="admin-title">📂 Dataset Management</h1>

    <div class="action-bar">
        <button class="btn btn-outline" @onclick="LoadAsync">🔄 Refresh</button>
        <span style="color:#666; font-size:0.82rem; margin-left:auto;">
            @_datasets.Count datasets · @FormatBytes(_totalSize) total
        </span>
    </div>

    @if (_datasets.Count == 0)
    {
        <div class="admin-empty">
            <div class="admin-empty-icon">📂</div>
            <p>No datasets in the platform yet.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Format</th>
                        <th>Size</th>
                        <th>Rows</th>
                        <th>Columns</th>
                        <th>Storage</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ds in _datasets)
                    {
                        <tr>
                            <td><strong>@ds.Name</strong></td>
                            <td><span class="format-badge">@ds.Format</span></td>
                            <td>@FormatBytes(ds.SizeBytes)</td>
                            <td>@ds.RowCount.ToString("N0")</td>
                            <td>@ds.ColumnCount</td>
                            <td>
                                @if (ds.StorageLocation == DatasetStorageLocation.AzureBlob)
                                {
                                    <span style="color:#60a5fa">☁️ Azure</span>
                                }
                                else
                                {
                                    <span style="color:#4ade80">💻 Local</span>
                                }
                            </td>
                            <td>@ds.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <button class="btn btn-xs btn-danger" @onclick="() => DeleteAsync(ds)" title="Delete">🗑️</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Dataset> _datasets = [];
    private long _totalSize;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _datasets = await DatasetService.GetAllAsync();
        _totalSize = _datasets.Sum(d => d.SizeBytes);
    }

    private async Task DeleteAsync(Dataset ds)
    {
        await DatasetService.DeleteAsync(ds.Id);
        await LoadAsync();
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_099_511_627_776 => $"{bytes / 1_099_511_627_776.0:F1} TB",
        >= 1_073_741_824 => $"{bytes / 1_073_741_824.0:F1} GB",
        >= 1_048_576 => $"{bytes / 1_048_576.0:F1} MB",
        >= 1024 => $"{bytes / 1024.0:F0} KB",
        _ => $"{bytes} B"
    };
}
