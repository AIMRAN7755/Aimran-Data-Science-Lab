@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IGatewayManager Gateway

<div class="ide-shell">
    <!-- ── Sidebar ──────────────────────────────────────────────── -->
    <aside class="ide-sidebar @(_sidebarCollapsed ? "collapsed" : "")">
        <AIMRAN_Data_Science_Lab.Components.Layout.NavMenu Collapsed="@_sidebarCollapsed" />
    </aside>

    <!-- ── Main Area ────────────────────────────────────────────── -->
    <div class="ide-main">
        <!-- ── Title Bar ────────────────────────────────────────── -->
        <header class="ide-titlebar">
            <div class="titlebar-left">
                <button class="titlebar-btn sidebar-toggle" @onclick="ToggleSidebar" title="Toggle Sidebar (Ctrl+B)">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/></svg>
                </button>
                <span class="titlebar-brand">AIMRAN Data Science Lab</span>
            </div>

            <div class="titlebar-center">
                <div class="command-palette-trigger" @onclick='() => Navigation.NavigateTo("knowledge")' title="Search commands & knowledge (Ctrl+K)">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.44 1.168a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/></svg>
                    <span>Search commands, files, knowledge…</span>
                    <kbd>Ctrl+K</kbd>
                </div>
            </div>

            <div class="titlebar-right">
                <button class="titlebar-btn" title="Notifications">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/></svg>
                </button>
                <div class="titlebar-separator"></div>
                <div class="env-badge">
                    <span class="env-dot"></span>
                    Local
                </div>
            </div>
        </header>

        <!-- ── Page Content ─────────────────────────────────────── -->
        <article class="ide-content">
            @Body
        </article>

        <!-- ── Status Bar ───────────────────────────────────────── -->
        <footer class="ide-statusbar">
            <div class="statusbar-left">
                <span class="status-item engine-indicator @(_pythonOk ? "online" : "offline")" title="Python Engine">
                    🐍 Python
                </span>
                <span class="status-item engine-indicator @(_rOk ? "online" : "offline")" title="R Engine">
                    📊 R
                </span>
                <span class="status-item engine-indicator @(_rustOk ? "online" : "offline")" title="Rust Engine">
                    ⚙️ Rust
                </span>
            </div>
            <div class="statusbar-right">
                <span class="status-item" title="IDE Version">v2.0.0</span>
                <span class="status-item">.NET 10</span>
            </div>
        </footer>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private bool _pythonOk;
    private bool _rustOk;
    private bool _rOk;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var health = await Gateway.CheckHealthAsync();
            _pythonOk = health.PythonEngine.IsHealthy;
            _rustOk = health.RustEngine.IsHealthy;
            _rOk = health.REngine.IsHealthy;
        }
        catch
        {
            // Engines not reachable yet — status bar shows offline
        }
    }

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;
}
