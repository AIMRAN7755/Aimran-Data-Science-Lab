    }

    private async Task SaveAPISettings()
    {
        // TODO: Implement save API settings
        await Task.CompletedTask;
    }

    private async Task ResetAPISettings()
    {
        // TODO: Reset to saved settings
        await Task.CompletedTask;
    }
}
