<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIMRAN_Data_Science_Lab"
             xmlns:sharedComponents="clr-namespace:AIMRAN_Data_Science_Lab.Components;assembly=AimranDataScienceLab.Shared"
             x:Class="AIMRAN_Data_Science_Lab.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type sharedComponents:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

