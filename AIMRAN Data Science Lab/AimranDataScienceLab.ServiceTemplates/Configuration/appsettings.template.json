{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "IncludeScopes": false,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss"
    }
  },
  "Service": {
    "Name": "SERVICE_NAME",
    "Version": "1.0.0",
    "InstanceId": "SERVICE_INSTANCE_ID",
    "Port": 5000,
    "RegistryUrl": "http://localhost:5001",
    "MaxConcurrentRequests": 100,
    "RequestTimeout": "00:00:30",
    "HealthCheckInterval": "00:00:10",
    "GracefulShutdownTimeout": "00:00:30"
  },
  "Features": {
    "EnableCaching": true,
    "EnableMetrics": true,
    "EnableTracing": false,
    "EnableProfiling": false,
    "EnableDiagnostics": true
  },
  "Resilience": {
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerTimeout": 60,
    "RetryCount": 3,
    "RetryDelayMs": 1000,
    "BulkheadMaxParallelization": 100,
    "TimeoutMs": 30000
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost;Database=aimran;Integrated Security=true;",
    "CommandTimeout": 60,
    "EnableRetries": true,
    "RetryCount": 3
  },
  "Cache": {
    "Type": "Redis",
    "ConnectionString": "localhost:6379",
    "DefaultExpiration": 300,
    "SlidingExpiration": 600
  },
  "Authentication": {
    "Enabled": true,
    "JwtSecret": "CHANGE_ME_IN_PRODUCTION",
    "JwtExpiration": 3600,
    "ApiKeyEnabled": true
  },
  "ServiceRegistry": {
    "Url": "http://localhost:5001",
    "RegistrationInterval": 30,
    "HealthCheckInterval": 10,
    "Timeout": 5000
  },
  "EventBus": {
    "Type": "RabbitMq",
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/aimran"
  },
  "Monitoring": {
    "Enabled": true,
    "MetricsInterval": 60,
    "PrometheusEnabled": true,
    "PrometheusPort": 9090,
    "AlertingEnabled": true
  },
  "Deployment": {
    "Environment": "Development",
    "Platform": "Docker",
    "Replicas": 1,
    "MaxReplicas": 10
  }
}
