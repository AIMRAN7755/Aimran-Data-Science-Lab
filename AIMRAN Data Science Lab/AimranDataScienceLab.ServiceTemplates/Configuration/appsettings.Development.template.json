{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "Service": {
    "Port": 5000,
    "RegistryUrl": "http://localhost:5001",
    "RequestTimeout": "00:00:60",
    "GracefulShutdownTimeout": "00:00:10"
  },
  "Features": {
    "EnableCaching": false,
    "EnableMetrics": true,
    "EnableTracing": true,
    "EnableProfiling": true,
    "EnableDiagnostics": true
  },
  "Resilience": {
    "CircuitBreakerThreshold": 2,
    "RetryCount": 5,
    "RetryDelayMs": 500
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=aimran_dev;Integrated Security=true;",
    "CommandTimeout": 300,
    "EnableRetries": false
  },
  "Cache": {
    "Type": "Memory",
    "DefaultExpiration": 60
  },
  "Deployment": {
    "Environment": "Development",
    "Platform": "Console",
    "Replicas": 1
  }
}
