{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning"
    }
  },
  "Service": {
    "Port": 5000,
    "RegistryUrl": "http://service-registry:5000",
    "RequestTimeout": "00:00:45",
    "GracefulShutdownTimeout": "00:00:20"
  },
  "Features": {
    "EnableCaching": true,
    "EnableMetrics": true,
    "EnableTracing": true,
    "EnableProfiling": false,
    "EnableDiagnostics": true
  },
  "Resilience": {
    "CircuitBreakerThreshold": 4,
    "RetryCount": 3,
    "RetryDelayMs": 1000
  },
  "Database": {
    "ConnectionString": "Server=staging-db.internal;Database=aimran_staging;Integrated Security=true;",
    "CommandTimeout": 120,
    "EnableRetries": true
  },
  "Cache": {
    "Type": "Redis",
    "ConnectionString": "staging-redis.internal:6379",
    "DefaultExpiration": 300
  },
  "Deployment": {
    "Environment": "Staging",
    "Platform": "Docker",
    "Replicas": 2,
    "MaxReplicas": 5
  }
}
