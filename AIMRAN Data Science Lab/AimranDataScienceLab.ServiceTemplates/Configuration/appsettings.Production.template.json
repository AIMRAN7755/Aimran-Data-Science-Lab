{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "System": "Error",
      "Microsoft": "Error"
    }
  },
  "Service": {
    "Port": 5000,
    "RegistryUrl": "http://service-registry:5000",
    "RequestTimeout": "00:00:30",
    "GracefulShutdownTimeout": "00:00:30"
  },
  "Features": {
    "EnableCaching": true,
    "EnableMetrics": true,
    "EnableTracing": false,
    "EnableProfiling": false,
    "EnableDiagnostics": false
  },
  "Resilience": {
    "CircuitBreakerThreshold": 5,
    "RetryCount": 2,
    "RetryDelayMs": 2000,
    "BulkheadMaxParallelization": 200,
    "TimeoutMs": 30000
  },
  "Database": {
    "ConnectionString": "Server=prod-db.internal;Database=aimran_prod;Integrated Security=true;Connection Timeout=15;",
    "CommandTimeout": 60,
    "EnableRetries": true,
    "RetryCount": 3
  },
  "Cache": {
    "Type": "Redis",
    "ConnectionString": "prod-redis-cluster.internal:6379,prod-redis-cluster.internal:6380,prod-redis-cluster.internal:6381",
    "DefaultExpiration": 600,
    "SlidingExpiration": 900
  },
  "Authentication": {
    "JwtSecret": "SET_VIA_ENVIRONMENT_VARIABLE",
    "JwtExpiration": 7200
  },
  "Monitoring": {
    "Enabled": true,
    "MetricsInterval": 60,
    "PrometheusEnabled": true,
    "AlertingEnabled": true
  },
  "Deployment": {
    "Environment": "Production",
    "Platform": "Kubernetes",
    "Replicas": 3,
    "MaxReplicas": 20
  }
}
