# AIMRAN Service Environment Variables Template
# Copy this file to .env and customize for your deployment environment

# ===== Service Configuration =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
DOTNET_ENVIRONMENT=Development

SERVICE_NAME=CHANGE_ME
SERVICE_VERSION=1.0.0
SERVICE_INSTANCE_ID=CHANGE_ME
SERVICE_PORT=5000

# ===== Registry & Discovery =====
SERVICE_REGISTRY_URL=http://localhost:5001
SERVICE_GATEWAY_URL=http://localhost:5003
SERVICE_NAMESPACE=aimran

# ===== Database Configuration =====
DB_PROVIDER=SqlServer
DB_SERVER=localhost
DB_DATABASE=aimran
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_TIMEOUT=15
DB_COMMAND_TIMEOUT=60
DB_ENABLE_RETRIES=true
DB_RETRY_COUNT=3

# ===== Cache Configuration =====
CACHE_TYPE=Redis
CACHE_CONNECTION_STRING=localhost:6379
CACHE_DEFAULT_EXPIRATION=300
CACHE_SLIDING_EXPIRATION=600

# ===== Authentication & Security =====
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRATION=3600
API_KEY=CHANGE_ME_IN_PRODUCTION
ENABLE_API_KEY_AUTH=true

# ===== Event Bus Configuration =====
EVENTBUS_TYPE=RabbitMq
EVENTBUS_HOST=localhost
EVENTBUS_PORT=5672
EVENTBUS_USERNAME=guest
EVENTBUS_PASSWORD=CHANGE_ME
EVENTBUS_VIRTUALHOST=/aimran

# ===== Monitoring & Logging =====
LOG_LEVEL=Information
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_PROFILING=false
ENABLE_DIAGNOSTICS=true
METRICS_INTERVAL=60
PROMETHEUS_PORT=9090

# ===== Resilience Policies =====
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
RETRY_COUNT=3
RETRY_DELAY_MS=1000
TIMEOUT_MS=30000

# ===== Azure Configuration (if using) =====
AZURE_SUBSCRIPTION_ID=CHANGE_ME
AZURE_TENANT_ID=CHANGE_ME
AZURE_CLIENT_ID=CHANGE_ME
AZURE_CLIENT_SECRET=CHANGE_ME
AZURE_STORAGE_ACCOUNT=CHANGE_ME
AZURE_STORAGE_KEY=CHANGE_ME

# ===== Cloud Configuration =====
CLOUD_PROVIDER=Azure
CLOUD_REGION=eastus

# ===== Slack/Notifications =====
SLACK_WEBHOOK_URL=CHANGE_ME
SENDGRID_API_KEY=CHANGE_ME

# ===== Deployment Specific =====
DEPLOYMENT_PLATFORM=Docker
DEPLOYMENT_ENVIRONMENT=Development
REPLICA_COUNT=1
MAX_REPLICA_COUNT=10
NODE_SELECTOR=

# ===== Health Check Configuration =====
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5
LIVENESS_PROBE_INITIAL_DELAY=10
READINESS_PROBE_INITIAL_DELAY=5

# ===== Feature Flags =====
FEATURE_ENABLE_CACHING=true
FEATURE_ENABLE_COMPRESSION=true
FEATURE_ENABLE_RATE_LIMITING=true
FEATURE_ENABLE_CORS=true
FEATURE_ENABLE_GRAPHQL=false

# ===== Performance Settings =====
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000
GRACEFUL_SHUTDOWN_TIMEOUT=30
CONNECTION_POOL_SIZE=50

# ===== Data Retention =====
LOG_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# ===== TLS/SSL Configuration =====
ENABLE_HTTPS=true
TLS_CERT_PATH=/etc/tls/certs/tls.crt
TLS_KEY_PATH=/etc/tls/certs/tls.key

# ===== Debug/Development Only =====
DEBUG_MODE=false
ENABLE_SWAGGER=true
ENABLE_API_DOCUMENTATION=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
