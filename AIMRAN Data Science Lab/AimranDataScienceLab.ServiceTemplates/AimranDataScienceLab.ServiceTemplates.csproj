<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Library</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<!-- Suppress boilerplate "missing XML doc comment" warnings; keep doc generation -->
	<NoWarn>$(NoWarn);CS1591</NoWarn>
	<PackageId>AimranDataScienceLab.ServiceTemplates</PackageId>
	<Version>1.0.0</Version>
	<Title>AIMRAN Service Templates</Title>
	<Description>Comprehensive service templates for Docker, Kubernetes, and Windows Services deployment</Description>
	<Authors>ABDULLAH IMRAN</Authors>
	<Company>AIMRAN</Company>
	<Product>AIMRAN Data Science Lab</Product>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
	<PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
	<PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>
