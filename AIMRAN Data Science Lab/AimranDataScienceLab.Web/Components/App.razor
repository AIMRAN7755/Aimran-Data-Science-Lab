@using MudBlazor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Enterprise-Grade Data Science Platform - AIMRAN Data Science Lab" />
    <meta name="theme-color" content="#667eea" />
    <title>AIMRAN Data Science Lab</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔬</text></svg>" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" />
    <link rel="stylesheet" href="theme.css" />
    <link rel="stylesheet" href="animations.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="AimranDataScienceLab.Web.styles.css" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="_content/AimranDataScienceLab.Shared/AimranDataScienceLab.Shared.bundle.scp.css" />

    <!-- Preload critical resources -->
    <link rel="preload" as="script" href="_framework/blazor.web.js" />
    <link rel="preload" as="script" href="_content/MudBlazor/MudBlazor.min.js" />
</head>
<body>
    <!-- Blazor Components -->
    <MudThemeProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <!-- Main Router with Error Boundary -->
    <div id="app">
        <Routes @rendermode="InteractiveServer" />
    </div>

    <!-- Fallback Error UI -->
    <div id="blazor-error-ui" data-nosnippet>
        <div style="
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            font-family: Roboto, sans-serif;
            z-index: 9999;
        ">
            <div style="text-align: center; padding: 40px;">
                <h1 style="font-size: 48px; margin: 0 0 20px 0;">🚨 Application Error</h1>
                <p style="font-size: 18px; margin: 0 0 30px 0;">An unhandled error has occurred. Please reload the application.</p>
                <button onclick="location.reload();" style="
                    padding: 12px 30px;
                    background-color: #4CAF50;
                    color: white;
                    border: none;
                    border-radius: 5px;
                    font-size: 16px;
                    cursor: pointer;
                    font-weight: bold;
                " onmouseover="this.style.backgroundColor='#45a049'" onmouseout="this.style.backgroundColor='#4CAF50'">
                    🔄 Reload Page
                </button>
            </div>
        </div>
    </div>

    <!-- Framework and Library Scripts -->
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>

    <!-- Application Global Error Handlers -->
    <script>
        // Log global errors for debugging
        window.addEventListener('unhandledrejection', event => {
            console.error('[AIMRAN] Unhandled Promise Rejection:', event.reason);
        });

        window.addEventListener('error', event => {
            console.error('[AIMRAN] Global Error:', event.error);
        });
    </script>
</body>
</html>
