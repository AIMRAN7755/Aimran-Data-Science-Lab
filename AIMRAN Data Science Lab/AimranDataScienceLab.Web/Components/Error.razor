@page "/Error"
@using System.Diagnostics
@inject HttpContext? HttpContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - AIMRAN Data Science Lab</title>
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="AimranDataScienceLab.Web.styles.css" />
</head>
<body>
    <div class="blazor-error-boundary">
        <div class="error-container">
            <div class="error-header">
                <h1>🚨 Oops! Something went wrong</h1>
                <p class="error-code">Error ID: @(Activity.Current?.Id ?? HttpContext?.TraceIdentifier ?? "N/A")</p>
            </div>

            <div class="error-content">
                <p class="error-message">
                    An unexpected error occurred while processing your request. 
                    Please try again later or contact support if the problem persists.
                </p>

                <div class="error-actions">
                    <a href="/" class="btn-primary">🏠 Return to Home</a>
                    <a href="javascript:window.history.back();" class="btn-secondary">⬅️ Go Back</a>
                </div>
            </div>

            <div class="error-details">
                <p class="small-text">
                    <strong>Trace ID:</strong> @(HttpContext?.TraceIdentifier ?? "N/A")
                </p>
            </div>
        </div>
    </div>

    <style>
        .error-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-family: 'Roboto', sans-serif;
        }

        .error-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .error-header h1 {
            font-size: 48px;
            margin: 0 0 10px 0;
            font-weight: bold;
        }

        .error-code {
            font-size: 14px;
            opacity: 0.8;
            margin: 10px 0 0 0;
        }

        .error-content {
            background: rgba(255, 255, 255, 0.1);
            padding: 40px;
            border-radius: 10px;
            max-width: 600px;
            text-align: center;
            backdrop-filter: blur(10px);
            margin-bottom: 30px;
        }

        .error-message {
            font-size: 18px;
            line-height: 1.6;
            margin: 0 0 30px 0;
        }

        .error-actions {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-primary, .btn-secondary {
            padding: 12px 30px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .btn-primary {
            background-color: #4CAF50;
            color: white;
        }

        .btn-primary:hover {
            background-color: #45a049;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            border: 2px solid white;
        }

        .btn-secondary:hover {
            background-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .error-details {
            background: rgba(0, 0, 0, 0.2);
            padding: 15px 30px;
            border-radius: 5px;
            font-size: 12px;
        }

        .small-text {
            margin: 0;
            opacity: 0.8;
        }

        @@media (max-width: 768px) {
            .error-header h1 {
                font-size: 32px;
            }

            .error-content {
                padding: 20px;
            }

            .error-actions {
                flex-direction: column;
            }

            .btn-primary, .btn-secondary {
                width: 100%;
            }
        }
    </style>
</body>
</html>

@code {
    protected override void OnInitialized()
    {
        // Error page will be shown by exception handler middleware
    }
}
