{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/.aimran-dsl-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "Name": "AIMRAN Data Science Lab",
    "Version": "1.0.0",
    "Environment": "Production"
  },
  "SignalR": {
    "MaximumReceiveMessageSize": 33554432,
    "EnableDetailedErrors": false
  },
  "MudBlazor": {
    "SnackbarPosition": "BottomLeft",
    "PreventDuplicates": true,
    "ShowCloseIcon": true,
    "VisibleStateDuration": 10000
  }
}

